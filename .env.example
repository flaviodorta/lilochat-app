# ── LiloChat dev environment ─────────────────────────────────────────────
# Copy to .env per app as each phase requires. Secrets are NEVER committed.
# Dev infra (docker/compose.dev.yml) uses lilochat/lilochat credentials — dev only.

# Postgres (database-per-service)
IDENTITY_DATABASE_URL=postgresql://lilochat:lilochat@localhost:5440/lilochat_identity
ROOMS_DATABASE_URL=postgresql://lilochat:lilochat@localhost:5440/lilochat_rooms
PLAYBACK_DATABASE_URL=postgresql://lilochat:lilochat@localhost:5440/lilochat_playback
CHAT_DATABASE_URL=postgresql://lilochat:lilochat@localhost:5440/lilochat_chat
ENGAGEMENT_DATABASE_URL=postgresql://lilochat:lilochat@localhost:5440/lilochat_engagement

# Redis
REDIS_URL=redis://localhost:6380

# RabbitMQ
RABBITMQ_URL=amqp://lilochat:lilochat@localhost:5672

# JWT (generate with: pnpm gen:keys — Phase 1.3)
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# Third parties (server-side only — never NEXT_PUBLIC_)
YOUTUBE_API_KEY=
MULTIAVATAR_API_KEY=

# Observability (profile obs)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# DD_API_KEY=   # only when enabling the Datadog exporter (ADR-011)
