PORT=4100
IDENTITY_SERVICE_URL=http://localhost:4101
ROOMS_SERVICE_URL=http://localhost:4102
PLAYBACK_SERVICE_URL=http://localhost:4103
REDIS_URL=redis://localhost:6380
# RS256 public key (base64 SPKI PEM) — pair generated with `pnpm gen:keys`
JWT_PUBLIC_KEY=
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=debug
NODE_ENV=development

# Admission control (token bucket, per key)
RATE_LIMIT_ANON_CAPACITY=30
RATE_LIMIT_ANON_REFILL_PER_SEC=0.5
RATE_LIMIT_AUTH_CAPACITY=120
RATE_LIMIT_AUTH_REFILL_PER_SEC=2
