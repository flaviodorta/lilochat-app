{
  "name": "@lilochat/realtime-gateway",
  "version": "0.0.0",
  "private": true,
  "description": "Realtime gateway: Socket.io termination (Redis adapter), domain events -> socket broadcasts, clock sync",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test",
    "test": "vitest run",
    "test:int": "vitest run -c vitest.integration.config.ts"
  },
  "dependencies": {
    "@lilochat/contracts": "workspace:*",
    "@lilochat/nest-shared": "workspace:*",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@opentelemetry/api": "^1.9.1",
    "@socket.io/redis-adapter": "^8.3.0",
    "dotenv": "^16.4.7",
    "ioredis": "^5.4.2",
    "jsonwebtoken": "^9.0.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@lilochat/tooling": "workspace:*",
    "@nestjs/testing": "^11.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^20.17.0",
    "eslint": "^9.17.0",
    "socket.io-client": "^4.8.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.0.0"
  }
}
