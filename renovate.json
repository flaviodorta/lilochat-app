{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":semanticCommits", "group:monorepos"],
  "rangeStrategy": "bump",
  "lockFileMaintenance": { "enabled": true, "schedule": ["before 6am on monday"] },
  "vulnerabilityAlerts": { "labels": ["security"] },
  "packageRules": [
    {
      "description": "Batch OpenTelemetry packages — they release in lockstep",
      "matchPackageNames": ["/^@opentelemetry//"],
      "groupName": "opentelemetry"
    },
    {
      "description": "Majors wait for a manual look (breaking-change review)",
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    }
  ]
}
